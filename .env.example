# Configurações da Aplicação Freshy
APP_NAME="Freshy"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/sofial/Freshy/public

# Configurações do Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=freshy_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Configurações de Sessão e Segurança
SESSION_NAME=freshy_session
SESSION_LIFETIME=7200
